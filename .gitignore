/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
Thumbs.db
Desktop.ini

# Archivos grandes o binarios que no deben subirse (opcional pero recomendado)
*.log
*.zip
*.rar

# Tu carpeta de assets si alguna vez tiene archivos muy grandes (pero en tu caso está bien subirla)
# Si en el futuro agregas videos o modelos muy pesados, considera usar Git LFS